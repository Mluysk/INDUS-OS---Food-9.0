<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Deixa arquivos e diretórios existentes passarem
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Envia todo o restante para o front controller
    RewriteRule ^ index.php [L]
</IfModule>
